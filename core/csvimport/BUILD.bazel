load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "csvimport_proto",
    srcs = ["table_source.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "csvimport_go_proto",
    importpath = "github.com/google/taxinomia/core/csvimport",
    proto = ":csvimport_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "csvimport",
    srcs = [
        "csv_import.go",
        "textproto.go",
    ],
    embed = [":csvimport_go_proto"],
    importpath = "github.com/google/taxinomia/core/csvimport",
    visibility = ["//visibility:public"],
    deps = [
        "//core/columns",
        "//core/tables",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)

go_test(
    name = "csvimport_test",
    srcs = [
        "csv_import_test.go",
        "textproto_test.go",
    ],
    embed = [":csvimport"],
)
