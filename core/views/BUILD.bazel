load("@rules_go//go:def.bzl", "go_library")

# Forwarding package: the real code lives in //web/viewmodel. Kept public so
# existing importers of github.com/google/taxinomia/core/views keep building;
# removed in CLEAN.
go_library(
    name = "views",
    srcs = ["views.go"],
    importpath = "github.com/google/taxinomia/core/views",
    visibility = ["//visibility:public"],
    deps = ["//web/viewmodel"],
)
