load("@rules_go//go:def.bzl", "go_library")

# Forwarding package: the real code lives in //web/urlquery (URL half) and
# //core/queryspec (spec vocabulary). Kept public so existing importers of
# github.com/google/taxinomia/core/query keep building; removed in CLEAN.
go_library(
    name = "query",
    srcs = ["query.go"],
    importpath = "github.com/google/taxinomia/core/query",
    visibility = ["//visibility:public"],
    deps = ["//web/urlquery"],
)
