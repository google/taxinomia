load("@rules_go//go:def.bzl", "go_library")

# Forwarding package: the real code lives in //web/rendering. Kept public so
# existing importers of github.com/google/taxinomia/core/rendering keep
# building; removed in CLEAN.
go_library(
    name = "rendering",
    srcs = ["rendering.go"],
    importpath = "github.com/google/taxinomia/core/rendering",
    visibility = ["//visibility:public"],
    deps = ["//web/rendering"],
)
