load("@rules_go//go:def.bzl", "go_library")

# Forwarding package: the real code lives in //web/handlers. Kept public so
# existing importers of github.com/google/taxinomia/core/server keep building;
# removed in CLEAN.
go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "github.com/google/taxinomia/core/server",
    visibility = ["//visibility:public"],
    deps = ["//web/handlers"],
)
