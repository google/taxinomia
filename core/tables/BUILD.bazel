load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tables",
    srcs = [
        "data_table.go",
        "sorting.go",
        "table_view.go",
        "table_view_ascii.go",
    ],
    importpath = "github.com/google/taxinomia/core/tables",
