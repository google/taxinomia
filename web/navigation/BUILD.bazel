load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "navigation",
    srcs = ["navigation.go"],
    importpath = "github.com/google/taxinomia/web/navigation",
    visibility = [
        "//core/query:__pkg__",
        "//core/rendering:__pkg__",
        "//core/server:__pkg__",
        "//core/views:__pkg__",
        "//demo:__pkg__",
        "//web:__subpackages__",
    ],
    deps = [
        "//core/engine",
        "//web/urlquery",
        "//web/viewmodel",
    ],
)

go_test(
    name = "navigation_test",
    srcs = ["navigation_test.go"],
    embed = [":navigation"],
    deps = [
        "//core/engine",
        "//web/urlquery",
        "//web/viewmodel",
    ],
)
