load("@rules_go//go:def.bzl", "go_library", "go_test")

go_test(
    name = "rendering_test",
    srcs = ["renderer_test.go"],
    embed = [":rendering"],
    deps = ["//web/viewmodel"],
)

go_library(
    name = "rendering",
    srcs = [
        "renderer.go",
        "static.go",
    ],
    embedsrcs = [
        "templates/landing.html",
        "templates/table.html",
        "static/table.css",
        "static/table-head.js",
        "static/table-body.js",
    ],
    importpath = "github.com/google/taxinomia/web/rendering",
    visibility = [
        "//core/query:__pkg__",
        "//core/rendering:__pkg__",
        "//core/server:__pkg__",
        "//core/views:__pkg__",
        "//demo:__pkg__",
        "//web:__subpackages__",
    ],
    deps = [
        "//web/viewmodel",
        "//core/buildinfo",
        "@com_github_google_safehtml//:safehtml",
        "@com_github_google_safehtml//template",
        "@com_github_google_safehtml//uncheckedconversions",
    ],
)
