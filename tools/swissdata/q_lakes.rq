SELECT ?l (SAMPLE(?label) AS ?name) (MAX(?area) AS ?area_m2) (MAX(?depth) AS ?max_depth_m) (MAX(?elev) AS ?elevation_m)
       (MAX(?vol) AS ?volume_m3) (GROUP_CONCAT(DISTINCT ?iso; separator="|") AS ?cantons) (SAMPLE(?coord) AS ?coord)
WHERE {
  ?l wdt:P31/wdt:P279* wd:Q23397; wdt:P17 wd:Q39.
  ?l p:P2046/psn:P2046/wikibase:quantityAmount ?area.
  FILTER(?area >= 1000000)
  OPTIONAL { ?l wdt:P131+ ?c. ?c wdt:P31 wd:Q23058; wdt:P300 ?iso. }
  OPTIONAL { ?l p:P4511/psn:P4511/wikibase:quantityAmount ?depth }
  OPTIONAL { ?l p:P2044/psn:P2044/wikibase:quantityAmount ?elev }
  OPTIONAL { ?l p:P2234/psn:P2234/wikibase:quantityAmount ?vol }
  OPTIONAL { ?l wdt:P625 ?coord }
  ?l rdfs:label ?label. FILTER(LANG(?label) = "en")
}
GROUP BY ?l ORDER BY DESC(?area_m2)
