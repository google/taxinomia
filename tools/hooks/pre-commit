#!/bin/sh
# Pre-commit hook: records the revision being created into
# core/buildinfo/version.go, so the version travels inside the library
# source and reaches every importer regardless of build system. The
# link-time git stamp (tools/workspace_status.*) adds the hash and dirty
# flag on top when present.
#
# Enable once per clone:   git config core.hooksPath tools/hooks
#
# The count is "commits reachable from the new commit": HEAD's history
# plus one, including MERGE_HEAD's history for a merge commit. A missed
# bump (commit made without the hook) is caught by
# TestSourceRevisionMatchesGit under `go test ./core/buildinfo/`.
set -e
root=$(git rev-parse --show-toplevel)
heads="HEAD"
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  heads="HEAD MERGE_HEAD"
fi
count=$(( $(git rev-list --count $heads 2>/dev/null || echo 0) + 1 ))
date=$(date +%Y-%m-%d)
f="$root/core/buildinfo/version.go"
cat > "$f" <<EOF
// Code generated by tools/hooks/pre-commit; DO NOT EDIT.

package buildinfo

// Revision of the source tree, recorded at commit time: the commit count
// and commit date of the revision this file was committed in. This is what
// importers of the library display; the link-time stamp (when present)
// overrides it and adds the commit hash and dirty flag.
const (
	sourceRevision = "$count"
	sourceDate     = "$date"
)
EOF
git add "$f"
