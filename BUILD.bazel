load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

# gazelle:prefix github.com/google/taxinomia
# gazelle:proto default
# gazelle:go_generate_proto true
# gazelle:exclude experimental/kerneleval
# gazelle:exclude experimental/memeval
# gazelle:exclude experimental/benchsuite

# Run `bazel run //:gazelle` to (re)generate BUILD files,
# and `bazel run //:gazelle-update-repos` is not needed under Bzlmod
# (use `bazel mod tidy` to sync go.mod deps into MODULE.bazel).
gazelle(name = "gazelle")

go_library(
    name = "taxinomia_lib",
    srcs = [
        "filesystem.go",
        "main.go",
    ],
    importpath = "github.com/google/taxinomia",
    visibility = ["//visibility:private"],
    deps = [
        "//datasources",
        "//demo",
        "//web/handlers",
    ],
)

go_binary(
    name = "taxinomia",
    # Demo data (user profiles, products, config tree) is read at runtime by
    # path, so it must be present in the binary's runfiles.
    data = ["//demo:runtime_data"],  # keep
    embed = [":taxinomia_lib"],
    visibility = ["//visibility:public"],
    # Build stamping (see .bazelrc and core/buildinfo): substituted from the
    # workspace status keys when --stamp is on, left empty otherwise.
    x_defs = {
        "github.com/google/taxinomia/core/buildinfo.commit": "{STABLE_GIT_COMMIT}",
        "github.com/google/taxinomia/core/buildinfo.revision": "{STABLE_GIT_REVISION}",
        "github.com/google/taxinomia/core/buildinfo.date": "{STABLE_GIT_DATE}",
        "github.com/google/taxinomia/core/buildinfo.dirty": "{STABLE_GIT_DIRTY}",
    },
)
