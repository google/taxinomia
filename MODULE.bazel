"""Taxinomia — Bazel module definition (Bzlmod)."""

module(
    name = "taxinomia",
    version = "0.1.0",
)

# Core rule sets.
bazel_dep(name = "rules_go", version = "0.55.1")
bazel_dep(name = "gazelle", version = "0.43.0")
bazel_dep(name = "protobuf", version = "29.3")
bazel_dep(name = "rules_proto", version = "7.1.0")

# Use prebuilt protoc binaries instead of compiling protobuf/abseil from C++
# source. This avoids requiring a local Visual C++ / clang toolchain just to
# run the proto compiler. Activated by
# --incompatible_enable_proto_toolchain_resolution (see .bazelrc).
bazel_dep(name = "toolchains_protoc", version = "0.6.1")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(
    # Provides well-known types (e.g. google/protobuf/timestamp.proto).
    google_protobuf = "com_google_protobuf",
    # Pin the prebuilt protoc release to match the protobuf module above.
    version = "v29.3",
)
use_repo(protoc, "toolchains_protoc_hub")

# The extension creates the toolchains but does not register them; do it here.
register_toolchains("@toolchains_protoc_hub//:all")

# Go SDK — pinned to match the toolchain declared in go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.12")

# External Go dependencies, sourced from go.mod / go.sum.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_google_safehtml",
    "org_golang_google_protobuf",
)
