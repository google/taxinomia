# SPDX-License-Identifier: Apache-2.0
# Switzerland: real data, mostly from the Swiss Federal Statistical Office
# (demo/data/switzerland/SOURCES.md).

name: "switzerland"
title: "Switzerland"
subtitle: "Every municipality, population 2024, and the federal popular votes of 2021 to 2025 by municipality. Sources: Swiss Federal Statistical Office, Federal Chancellery, Wikidata."

domains: "switzerland"

default_columns { table_name: "ch_municipalities" columns: "name" columns: "canton" columns: "district" columns: "language_region" columns: "urbanisation" columns: "population" columns: "foreign_pct" columns: "over_65_pct" columns: "median_age" columns: "density" columns: "elevation_m" }
default_columns { table_name: "ch_votes" columns: "date" columns: "title" columns: "kind" columns: "accepted" columns: "yes_pct" columns: "turnout_pct" }
default_columns { table_name: "ch_vote_results" columns: "vote" columns: "bfs_nr" columns: "yes_pct" columns: "turnout_pct" columns: "yes" columns: "no" }
