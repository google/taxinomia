# SPDX-License-Identifier: Apache-2.0
# Switzerland: real data from the Swiss Federal Statistical Office and
# Wikidata (demo/data/switzerland/SOURCES.md).

name: "switzerland"
title: "Switzerland"
subtitle: "Regions, cantons, districts and municipalities, population 2024, mountains and lakes. Sources: Swiss Federal Statistical Office (commune register, STAT-TAB) and Wikidata."

domains: "switzerland"

default_columns { table_name: "ch_municipalities" columns: "name" columns: "canton" columns: "district" columns: "language_region" columns: "urbanisation" columns: "population" columns: "foreign_pct" columns: "area_km2" columns: "density" columns: "elevation_m" }
default_columns { table_name: "ch_cantons" columns: "canton" columns: "name" columns: "capital" columns: "joined" columns: "official_languages" columns: "region" }
default_columns { table_name: "ch_districts" columns: "district" columns: "name" columns: "canton" }
default_columns { table_name: "ch_regions" columns: "region" columns: "local_name" }
default_columns { table_name: "ch_mountains" columns: "name" columns: "elevation_m" columns: "prominence_m" columns: "range" columns: "canton" columns: "cantons" }
default_columns { table_name: "ch_lakes" columns: "name" columns: "area_km2" columns: "max_depth_m" columns: "elevation_m" columns: "volume_km3" columns: "canton" columns: "cantons" }
