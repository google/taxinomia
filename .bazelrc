# Use the Bzlmod dependency system (default in Bazel 7+, explicit here for clarity).
common --enable_bzlmod

# Resolve protoc via the registered toolchain (prebuilt binaries from
# toolchains_protoc) rather than building protobuf/abseil from C++ source.
common --incompatible_enable_proto_toolchain_resolution

# Fetch repos as needed and keep a lockfile for reproducibility.
common --lockfile_mode=update

# Treat warnings from external repos as non-fatal noise we don't control.
build --incompatible_disallow_empty_glob=false

# Materialize a real runfiles tree (default on Windows is a manifest only), so
# tests that open data files by relative path can find them.
build --enable_runfiles

# Stamp //:taxinomia with the git revision (core/buildinfo): the workspace
# status command emits STABLE_GIT_* keys, so the binary relinks once per
# commit and the UI shows the build it is serving. Platform-specific config
# picks the script Bazel can execute directly on this OS.
common --enable_platform_specific_config
build --stamp
build:windows --workspace_status_command=tools/workspace_status.cmd
build:linux --workspace_status_command=tools/workspace_status.sh
build:macos --workspace_status_command=tools/workspace_status.sh

# Nicer test output by default.
test --test_output=errors
test --test_summary=terse

# Allow project-local overrides without touching this file.
try-import %workspace%/user.bazelrc
